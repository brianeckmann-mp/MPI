{
  "name": "maxpreps-ai-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:varsity-signal-assets": "node scripts/build-varsity-signal-assets.mjs",
    "dashboard:snapshot": "node scripts/design-system-dashboard-data.mjs snapshot",
    "dashboard:update": "node scripts/design-system-dashboard-data.mjs update",
    "dashboard:update:dry-run": "node scripts/design-system-dashboard-data.mjs update --dry-run",
    "build:school-os-shadcn": "npm --prefix projects/school-os/shadcn run build -- --outDir ../../../dist/projects/school-os/shadcn --emptyOutDir",
    "build": "vite build && npm run build:school-os-shadcn",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "agentation": "^2.3.3",
    "phaser": "^3.90.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.1"
  }
}
